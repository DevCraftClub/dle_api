{% include 'pages/settings.twig' %}

<style>
	.dleapi-placeholder-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: .35rem;
		width: 100%;
	}

	.dleapi-placeholder-list .text-small {
		width: 100%;
	}

	.code_editor_area {
		border: 1px solid #cccccc;
	}
</style>

{% include 'core/includes/ui/templateIncludes/code_editor_scripts.twig' %}
{% if pm_wysiwyg and pm_editor_script %}
	{% include 'core/includes/ui/templateIncludes/tinymce_editor_scripts.twig' %}
{% endif %}
<script>
	(function () {
		function refreshPlaceholders() {
			if (window.DleApiAdminSettings && typeof window.DleApiAdminSettings.renderPlaceholderLists === 'function') {
				window.DleApiAdminSettings.renderPlaceholderLists();
			}
		}

		var tabs = document.getElementById('settings-tabs');
		if (tabs) {
			tabs.addEventListener('tab-open', refreshPlaceholders);
		}
		document.addEventListener('click', function (e) {
			var t = e.target;
			if (t && t.closest && t.closest('#settings-tabs')) {
				refreshPlaceholders();
			}
		});
	})();
</script>
