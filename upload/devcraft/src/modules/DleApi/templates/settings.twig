{% include 'pages/settings.twig' %}

<style>
	.dleapi-placeholder-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: .35rem;
	}

	.dleapi-placeholder-list .text-small {
		width: 100%;
	}
</style>

{% if pm_wysiwyg and pm_editor_script %}
<script src="{{ dle_home }}public/js/jquery3.js"></script>
<script src="{{ dle_home }}public/editor/tiny_mce/tinymce.min.js"></script>
<script>
	var dle_root = '{{ dle_home|e('js') }}';
	var dle_login_hash = '{{ dle_login_hash|e('js') }}';
	var dle_skin = '{{ dle_skin|e('js') }}';
	window.DLEPasteSafeText = window.DLEPasteSafeText || function (args) { return args; };
</script>
<script>
(function () {
	var inited = false;
	var editorScript = function () {
		{{ pm_editor_script|raw }}
	};

	function initPmEditors() {
		if (inited || typeof tinymce === 'undefined') {
			return;
		}
		var nodes = document.querySelectorAll('textarea.ajaxwysiwygeditor.dc-dleapi-editor');
		if (!nodes.length) {
			return;
		}
		var visible = false;
		for (var i = 0; i < nodes.length; i++) {
			if (nodes[i].offsetParent !== null || nodes[i].getClientRects().length) {
				visible = true;
				break;
			}
		}
		if (!visible) {
			return;
		}
		inited = true;
		if (window.jQuery) {
			jQuery(function () { editorScript(); });
		} else {
			editorScript();
		}
	}

	function bindTabInit() {
		var tabs = document.getElementById('settings-tabs');
		if (tabs) {
			tabs.addEventListener('tab-open', function () {
				if (window.DleApiAdminSettings && typeof window.DleApiAdminSettings.renderPlaceholderLists === 'function') {
					window.DleApiAdminSettings.renderPlaceholderLists();
				}
				setTimeout(initPmEditors, 50);
			});
		}
		document.addEventListener('click', function (e) {
			var t = e.target;
			if (!t || !t.closest) {
				return;
			}
			if (t.closest('#settings-tabs')) {
				if (window.DleApiAdminSettings && typeof window.DleApiAdminSettings.renderPlaceholderLists === 'function') {
					window.DleApiAdminSettings.renderPlaceholderLists();
				}
				setTimeout(initPmEditors, 80);
			}
		});
		var form = document.querySelector('form.dc-settings-form, form[data-role="validator"], #page-content form');
		if (form) {
			form.addEventListener('submit', function () {
				if (typeof tinymce !== 'undefined' && tinymce.triggerSave) {
					tinymce.triggerSave();
				}
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', function () {
			if (window.DleApiAdminSettings && typeof window.DleApiAdminSettings.renderPlaceholderLists === 'function') {
				window.DleApiAdminSettings.renderPlaceholderLists();
				window.DleApiAdminSettings.bindPlaceholderClicks();
			}
			bindTabInit();
			setTimeout(initPmEditors, 200);
		});
	} else {
		if (window.DleApiAdminSettings && typeof window.DleApiAdminSettings.renderPlaceholderLists === 'function') {
			window.DleApiAdminSettings.renderPlaceholderLists();
			window.DleApiAdminSettings.bindPlaceholderClicks();
		}
		bindTabInit();
		setTimeout(initPmEditors, 200);
	}
})();
</script>
{% endif %}
