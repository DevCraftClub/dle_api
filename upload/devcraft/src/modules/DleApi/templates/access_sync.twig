<div class="container-fluid">
	<div class="remark info mb-3">
		{{ 'Если группа не привязана — при самогенерации используется уровень по умолчанию из настроек; на ключах уровень задаётся вручную.'|trans }}
	</div>
	<div class="panel">
		<div class="panel-title"><span class="caption">{{ 'Группа DLE → уровень доступа'|trans }}</span></div>
		<div class="panel-content">
			<form id="dleapi-access-sync-form" method="post" action="#">
				<table class="table striped table-border">
					<thead>
					<tr>
						<th>{{ 'Группа'|trans }}</th>
						<th>{{ 'Уровень доступа'|trans }}</th>
					</tr>
					</thead>
					<tbody>
					{% for g in groups %}
						<tr>
							<td>#{{ g.id }} — {{ g.name }}</td>
							<td>
								<select class="metro-input" name="map[{{ g.id }}]">
									<option value="0">{{ '— не задано —'|trans }}</option>
									{% for level in levels %}
										<option value="{{ level.id }}" {% if level.id == g.access_level_id %}selected{% endif %}>{{ level.name }}</option>
									{% endfor %}
								</select>
							</td>
						</tr>
					{% else %}
						<tr><td colspan="2">{{ 'Группы не найдены'|trans }}</td></tr>
					{% endfor %}
					</tbody>
				</table>
				<button type="submit" class="button primary mt-2">{{ 'Сохранить'|trans }}</button>
			</form>
		</div>
	</div>
</div>
