<div class="container-fluid">
	<div class="row">
		<div class="cell-md-7">
			<div class="panel">
				<div class="panel-title">{{ 'Уровни доступа'|trans }}</div>
				<div class="panel-content">
					<table class="table striped table-border mt-2">
						<thead>
						<tr>
							<th>#</th>
							<th>{{ 'Название'|trans }}</th>
							<th>{{ 'Сорт.'|trans }}</th>
							<th>{{ 'Активен'|trans }}</th>
							<th>{{ 'Премод.'|trans }}</th>
							<th>own_only</th>
							<th>cheater</th>
							<th>{{ 'Действия'|trans }}</th>
						</tr>
						</thead>
						<tbody id="dleapi-levels-tbody">
						{% for level in levels %}
							<tr data-level-id="{{ level.id }}">
								<td>{{ level.id }}</td>
								<td>{{ level.name }}</td>
								<td>{{ level.sort }}</td>
								<td>{{ level.active ? 'Да'|trans : 'Нет'|trans }}</td>
								<td>{{ level.premoderate ? 'Да'|trans : 'Нет'|trans }}</td>
								<td>{{ level.own_only ? 'Да'|trans : 'Нет'|trans }}</td>
								<td>{{ level.cheater ? 'Да'|trans : 'Нет'|trans }}</td>
								<td>
									<button type="button" class="button small" data-dleapi-edit-level="{{ level.id }}">{{ 'Изменить'|trans }}</button>
									<button type="button" class="button alert small" data-dleapi-delete-level="{{ level.id }}">{{ 'Удалить'|trans }}</button>
								</td>
							</tr>
						{% else %}
							<tr class="dleapi-levels-empty"><td colspan="8">{{ 'Уровней пока нет'|trans }}</td></tr>
						{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div class="cell-md-5">
			<div class="panel">
				<div class="panel-title" id="dleapi-level-form-title"
					 data-label-create="{{ 'Создать уровень'|trans|e('html_attr') }}">{{ 'Создать уровень'|trans }}</div>
				<div class="panel-content">
					<form id="dleapi-level-form" method="post" action="#">
						<input type="hidden" name="id" id="dleapi-level-id" value="">
						<div class="form-group">
							<label>{{ 'Название'|trans }}</label>
							<input type="text" name="name" class="metro-input" required>
						</div>
						<div class="form-group">
							<label>{{ 'Сортировка'|trans }}</label>
							<input type="number" name="sort" class="metro-input" value="0">
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="active" value="1" checked> {{ 'Активен'|trans }}</label>
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="premoderate" value="1"> {{ 'Премодерация заявок на ключ'|trans }}</label>
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="own_only" value="1" checked> {{ 'Только свои записи'|trans }}</label>
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="cheater" value="1"> {{ 'Полный доступ (cheater)'|trans }}</label>
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="mask_ip" value="1" checked> {{ 'Маскировать IP'|trans }}</label>
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="mask_passwords" value="1" checked> {{ 'Маскировать пароли/хеши'|trans }}</label>
						</div>
						<div class="form-group">
							<label><input type="checkbox" name="mask_personal" value="1" checked> {{ 'Маскировать лишние ПДн'|trans }}</label>
						</div>
						<div class="d-flex">
							<button type="submit" class="button primary" id="dleapi-level-submit">{{ 'Сохранить'|trans }}</button>
							<button type="button" class="button ml-2" id="dleapi-level-cancel" hidden>{{ 'Отмена'|trans }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<div class="row mt-2">
		<div class="cell-12">
			<div class="panel">
				<div class="panel-title">{{ 'Scopes уровня (read / write / edit / delete)'|trans }}</div>
				<div class="panel-content">
					<div class="table-container" style="max-height: 420px; overflow: auto;">
						<table class="table striped table-border table-sm" id="dleapi-level-scopes-table">
							<thead>
							<tr>
								<th>{{ 'Таблица'|trans }}</th>
								<th class="text-center">{{ 'Чтение'|trans }}</th>
								<th class="text-center">{{ 'Запись'|trans }}</th>
								<th class="text-center">{{ 'Правка'|trans }}</th>
								<th class="text-center">{{ 'Удаление'|trans }}</th>
							</tr>
							</thead>
							<tbody>
							{% for table in scope_tables %}
								<tr>
									<td><code>{{ table }}</code></td>
									<td class="text-center"><input type="checkbox" data-level-scope="read" data-table="{{ table }}"></td>
									<td class="text-center"><input type="checkbox" data-level-scope="write" data-table="{{ table }}"></td>
									<td class="text-center"><input type="checkbox" data-level-scope="edit" data-table="{{ table }}"></td>
									<td class="text-center"><input type="checkbox" data-level-scope="delete" data-table="{{ table }}"></td>
								</tr>
							{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
