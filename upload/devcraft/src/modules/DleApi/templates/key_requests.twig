<div class="container-fluid">
	<div class="panel">
		<div class="panel-title">{{ 'Заявки на API-ключ'|trans }}</div>
		<div class="panel-content">
			<table class="table striped table-border">
				<thead>
				<tr>
					<th>#</th>
					<th>{{ 'User ID'|trans }}</th>
					<th>{{ 'Уровень'|trans }}</th>
					<th>{{ 'Статус'|trans }}</th>
					<th>{{ 'Дата'|trans }}</th>
					<th>{{ 'Действия'|trans }}</th>
				</tr>
				</thead>
				<tbody id="dleapi-requests-tbody">
				{% for req in requests %}
					<tr data-request-id="{{ req.id }}">
						<td>{{ req.id }}</td>
						<td>{{ req.user_id }}</td>
						<td>{{ req.level_name }}</td>
						<td data-status>{{ req.status }}</td>
						<td>{{ req.created }}</td>
						<td>
							{% if req.status == 'pending' %}
								<button type="button" class="button success small" data-dleapi-approve-request="{{ req.id }}">{{ 'Одобрить'|trans }}</button>
								<button type="button" class="button alert small" data-dleapi-deny-request="{{ req.id }}">{{ 'Отклонить'|trans }}</button>
							{% else %}
								—
							{% endif %}
						</td>
					</tr>
				{% else %}
					<tr><td colspan="6">{{ 'Заявок нет'|trans }}</td></tr>
				{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>
