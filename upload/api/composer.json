{
	"name": "devcraftclub/dle-api",
	"description": "Неофициальное REST API для DataLife Engine",
	"require": {
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-simplexml": "*",
		"league/oauth2-server": "^9.0",
		"monolog/monolog": "^3.8",
		"php-di/php-di": "^7.0",
		"slim/psr7": "^1.7",
		"slim/slim": "^4.14",
		"zircote/swagger-php": "^5.0"
	},
	"autoload": {
		"psr-4": {
			"DleApi\\": "src/",
			"JetBrains\\PhpStorm\\": "src/Support/PhpStorm/"
		},
		"classmap": [
			"sdk/DcApi.php"
		],
		"files": [
			"src/Fluent/DcDatabase.php",
			"src/Fluent/functions.php"
		]
	},
	"scripts": {
		"openapi": [
			"@php vendor/bin/openapi -b vendor/autoload.php -o ../../apidata/openapi.yaml -f yaml ./src/OpenApi ./src/Schema ./src/Xfield/Schema"
		]
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	}
}
