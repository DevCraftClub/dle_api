{
	"name": "devcraftclub/dle-api",
	"description": "Неофициальное REST API для DataLife Engine",
	"license": "GPL-3.0-only",
	"require": {
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-simplexml": "*",
		"league/oauth2-server": "^9.0",
		"monolog/monolog": "^3.8",
		"php-di/php-di": "^7.0",
		"slim/psr7": "^1.7",
		"slim/slim": "^4.14",
		"zircote/swagger-php": "^6.6"
	},
	"autoload": {
		"psr-4": {
			"DleApi\\": "src/",
			"JetBrains\\PhpStorm\\": "src/Support/PhpStorm/"
		},
		"classmap": [
			"sdk/DcApi.php"
		],
		"files": [
			"src/Fluent/DcDatabase.php",
			"src/Fluent/functions.php"
		]
	},
	"require-dev": {
		"guzzlehttp/guzzle": "^8.0",
		"phpunit/phpunit": "^12.5"
	},
	"autoload-dev": {
		"psr-4": {
			"DleApi\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"openapi": [
			"@php vendor/zircote/swagger-php/bin/openapi -b vendor/autoload.php -o ../../apidata/openapi.yaml -f yaml ./src/OpenApi ./src/Schema ./src/Xfield/Schema"
		]
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	}
}
