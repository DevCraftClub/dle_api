{
	"name": "devcraftclub/dle-api",
	"description": "Неофициальное REST API для DataLife Engine",
	"license": "MIT",
	"require": {
		"ext-json": "*",
		"ext-pdo": "*",
		"ext-simplexml": "*",
		"league/oauth2-server": "^9.0",
		"monolog/monolog": "^3.8",
		"php-di/php-di": "^7.0",
		"slim/psr7": "^1.7",
		"slim/slim": "^4.14",
		"zircote/swagger-php": "^6.6"
	},
	"autoload": {
		"psr-4": {
			"DleApi\\": "src/"
		}
	},
	"require-dev": {
		"guzzlehttp/guzzle": "^8.0",
		"phpunit/phpunit": "^12.5"
	},
	"autoload-dev": {
		"psr-4": {
			"DleApi\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"openapi": [
			"@php scripts/generate-openapi.php"
		]
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	}
}
